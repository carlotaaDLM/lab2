mport java.util.Scanner;

public class DeviceManager {
 private Modem[] listaModems = new Modem[100];
 private AccessPoint[] listaAPs = new AccessPoint[100];
 private Switch[] listaSwitches = new Switch[100];
 private Router[] listaRouters = new Router[100];

 private int contadorModems = 0;
 private int contadorAPs = 0;
 private int contadorSwitches = 0;
 private int contadorRouters = 0;

 // --- MÉTODOS DE MÓDEM ---
 public Modem fetchModemFromConsole(Scanner scanner) {
 System.out.println("Ingrese la informacion del modem");
 System.out.print("Marca: ");
 String marca = scanner.nextLine();
 System.out.print("Tecnologia: ");
 String tecnologia = scanner.nextLine();
 return new Modem(tecnologia, marca);
 }

 public void addModem(Modem modem) {
 listaModems[contadorModems] = modem;
 contadorModems++;
 System.out.println("--Modem agregado--");
 }

 // --- MÉTODOS DE ACCESS POINT ---
 public AccessPoint fetchApFromConsole(Scanner scanner, String marcaRouter) {
 if (marcaRouter == null) {
 System.out.println("Ingrese la informacion del Access Point");
 System.out.print("Fabricante: ");
 marcaRouter = scanner.nextLine();
 }
 System.out.print("Numero de antenas: ");
 int numeroAntenas = Integer.parseInt(scanner.nextLine());
 return new AccessPoint(marcaRouter, numeroAntenas);
 }

 public void addAccessPoint(AccessPoint ap) {
 listaAPs[contadorAPs] = ap;
 contadorAPs++;
 System.out.println("--Access Point agregado--");
 }

 // --- MÉTODOS DE SWITCH ---
 public Switch fetchSwitchFromConsole(Scanner scanner) {
 System.out.println("Ingrese la informacion del Switch como trama");
 System.out.print("Trama (modelo_puertos): ");
 String[] partes = scanner.nextLine().split("_");
 return new Switch(partes[0], Integer.parseInt(partes[1]));
 }

 public void addSwitch(Switch sw) {
 if (sw.getNumeroPuertos() % 2 == 0) {
 listaSwitches[contadorSwitches] = sw;
 contadorSwitches++;
 System.out.println("--Switch agregado--");
 } else {
 System.out.println("Error: El numero de puertos debe ser multiplo de 2.");
 }
 }

 // --- MÉTODOS DE ROUTER ---
 public Router fetchRouterFromConsole(Scanner scanner) {
 System.out.println("Ingrese la informacion del Router");
 System.out.print("Marca: ");
 String marca = scanner.nextLine();
 System.out.print("IP de gestion: ");
 String ip = scanner.nextLine();

 Switch swIntegrado = null;
 System.out.print("¿Tiene Switch integrado? (S/N): ");
 if (scanner.nextLine().equalsIgnoreCase("S")) {
 swIntegrado = fetchSwitchFromConsole(scanner);
 }

 AccessPoint apIntegrado = null;
 System.out.print("¿Tiene Access Point integrado? (S/N): ");
 if (scanner.nextLine().equalsIgnoreCase("S")) {
 apIntegrado = fetchApFromConsole(scanner, marca);
 }

 return new Router(ip, marca, apIntegrado, swIntegrado);
 }

 public void addRouter(Router router) {
 for (int i = 0; i < contadorRouters; i++) {
 if (listaRouters[i].getIp().equals(router.getIp())) {
 System.out.println("La IP ya existe. No se guardo el router.");
 return;
 }
 }
 listaRouters[contadorRouters] = router;
 contadorRouters++;
 System.out.println("--Router agregado--");
 }

 // --- MÉTODOS DE VISTA Y BÚSQUEDA ---
 public void showAllDevices() {
 System.out.println("\n--- Lista de equipos ---");
 if (contadorModems == 0) System.out.println("No hay modems registrados");
 else System.out.println("Modems encontrados: " + contadorModems);

 if (contadorAPs == 0) System.out.println("No hay Access Points registrados");
 else System.out.println("Access Points encontrados: " + contadorAPs);

 if (contadorSwitches == 0) System.out.println("No hay Switches registrados");
 else System.out.println("Switches encontrados: " + contadorSwitches);

 if (contadorRouters == 0) System.out.println("No hay Routers registrados");
 else {
 System.out.println("Routers... Encontrados: " + contadorRouters);
 for (int i = 0; i < contadorRouters; i++) {
 Router r = listaRouters[i];
 System.out.println((i + 1) + " Marca: " + r.getMarca() + " / IP: " + r.getIp());
 if (r.getAp() != null) System.out.println(" AP del router: Antenas: " + r.getAp().getNumeroAntena());
 if (r.getSw() != null) System.out.println(" SW del router: Puertos: " + r.getSw().getNumeroPuertos());
 }
 }
 }

 public void searchRouters(Scanner scanner) {
 if (contadorRouters == 0) {
 System.out.println("No hay routers registrados");
 return;
 }
 System.out.print("Ingrese la palabra a buscar: ");
 String palabra = scanner.nextLine();
 int encontrados = 0;

 for (int i = 0; i < contadorRouters; i++) {
 Router r = listaRouters[i];
 if (r.getIp().equals(palabra) || r.getMarca().equalsIgnoreCase(palabra)) {
 System.out.println("Encontrado -> Marca: " + r.getMarca() + " / IP: " + r.getIp());
 encontrados++;
 }
 }
 if (encontrados == 0) System.out.println("No se encontro ningun router");
 }
}
